{
  "name": "@neuralwire/og",
  "version": "1.0.0",
  "description": "Dynamic Open Graph (OG) Image Generation Microservice for Neuralwire",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "og-image",
    "open-graph",
    "satori",
    "resvg",
    "neuralwire",
    "microservice",
    "hono"
  ],
  "author": "Neuralwire Media <dev@neuralwire.info>",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.7.4",
    "satori": "^0.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
